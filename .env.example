# The Odds API — free key at https://the-odds-api.com (500 requests/month free)
ODDS_API_KEY=your_odds_api_key_here

# Kalshi — free account at https://kalshi.com
KALSHI_EMAIL=your_email@example.com
KALSHI_PASSWORD=your_password_here

# Cache settings (optional — these are the defaults)
# CACHE_TTL_SECONDS=7200          # 2 hours for Odds API responses
# KALSHI_CACHE_TTL_SECONDS=1800   # 30 minutes for Kalshi responses
